# Copy this file to .env and fill in your key. .env is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
GEMINI_MODEL=gemini-4-carbon
# Tried in order if the model above refuses your key (403) or is retired (404)
GEMINI_FALLBACK_MODELS=gemini-4-argon,gemini-4-hydrogen
COMPANY_NAME=Digital Shelf Insights
# Shown in the PDF footer and cover; leave empty to hide
COMPANY_WEBSITE=
# DATA_DIR=data
# OUTPUT_DIR=output
# HOST=127.0.0.1
# PORT=8000
